{
  // ============================================================
  // Unity 工程：在【文件资源管理器】里隐藏 .meta 文件
  //
  // .meta 是 Unity 资源数据库用来记录 GUID / 导入设置的，日常不需要看到。
  //
  // 说明（重要）：
  //   1) 这里只影响资源管理器的【显示】。.meta 仍在磁盘上，Unity 照常读取，不受影响。
  //   2) 搜索仍然能找到它们 —— VS Code 的搜索由 search.exclude 控制，
  //      与 files.exclude 是两项独立设置。所以 Ctrl+Shift+F 搜 GUID 依然有效。
  //   3) 临时需要看 .meta 时：把下面这行改成 false，或在系统资源管理器里查看。
  // ============================================================
  "files.exclude": {
    "**/*.meta": true
  }
}
